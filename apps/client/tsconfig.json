{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
